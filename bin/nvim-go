#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
export PROJECT_ROOT

usage() {
  cat <<'EOF'
Usage: nvim-go <command> [options]

Commands:
  install              Install or reconcile the complete Go IDE
  update [options]     Install a stable project release incrementally
  doctor               Diagnose the installation
  rollback [version]   Return to an installed release
  version              Print the project version
  help                 Show this help

Update options:
  --check              Report whether an update is available
  --dry-run            Show the update without changing anything
  --version VERSION    Install a specific stable release
EOF
}

command_name="${1:-help}"
shift || true

case "$command_name" in
  install|update|doctor|rollback)
    exec "${PROJECT_ROOT}/lib/${command_name}.sh" "$@"
    ;;
  version)
    # shellcheck disable=SC1091
    source "${PROJECT_ROOT}/manifests/versions.env"
    printf 'nvim-go %s\n' "$PROJECT_VERSION"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
